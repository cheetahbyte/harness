{
	"name": "harnez",
	"version": "0.2.2",
	"description": "Minimal harness for agentic coding and more.",
	"keywords": [],
	"homepage": "https://github.com/cheetahbyte/harnez#readme",
	"bugs": {
		"url": "https://github.com/cheetahbyte/harnez/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cheetahbyte/harnez.git"
	},
	"bin": {
		"harnez": "bin/harnez.js"
	},
	"directories": {
		"doc": "docs"
	},
	"workspaces": [
		"packages/*"
	],
	"files": [
		"bin",
		"README.md"
	],
	"type": "commonjs",
	"main": "index.js",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun --watch packages/server/src/index.ts",
		"server": "bun packages/server/src/index.ts",
		"auth": "bun packages/server/src/auth.ts",
		"tui": "bun packages/tui/src/index.ts",
		"cli": "bun packages/cli/src/index.ts",
		"build:binary": "bun build packages/cli/src/index.ts --compile --outfile dist/harnez",
		"test": "bun test",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"check": "bun run lint && bun run format:check && bun run typecheck",
		"fix": "oxfmt && oxlint --fix",
		"prepare": "git config core.hooksPath .githooks",
		"knip": "knip-bun"
	},
	"dependencies": {
		"@ade_oshineye/yaket": "0.5.3",
		"@earendil-works/pi-agent-core": "^0.84.1",
		"@earendil-works/pi-ai": "^0.84.1",
		"@opentui/core": "^0.5.1",
		"pino": "^10.3.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"bun-types": "^1.3.14",
		"knip": "^6.32.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "^7.0.2"
	},
	"knip": {
		"project": [
			"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
			"!docs/**"
		]
	}
}
