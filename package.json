{
	"name": "harnez",
	"version": "0.1.8",
	"bin": {
		"harnez": "bin/harnez.js"
	},
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/cheetahbyte/harnez.git"
	},
	"files": [
		"bin",
		"README.md"
	],
	"knip": {
		"project": [
			"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
			"!docs/**"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun --watch packages/server/src/index.ts",
		"server": "bun packages/server/src/index.ts",
		"auth": "bun packages/server/src/auth.ts",
		"tui": "bun packages/tui/src/index.ts",
		"cli": "bun packages/cli/src/index.ts",
		"build:binary": "bun build packages/cli/src/index.ts --compile --outfile dist/harnez",
		"test": "bun test",
		"check": "biome check .",
		"prepare": "git config core.hooksPath .githooks",
		"knip": "knip-bun",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.1",
		"@earendil-works/pi-ai": "^0.84.1",
		"@opentui/core": "^0.5.1",
		"pino": "^10.3.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^26.2.0",
		"bun-types": "^1.3.14",
		"knip": "^6.32.0",
		"typescript": "^7.0.2"
	}
}
