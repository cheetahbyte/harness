{
	"name": "docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build && rm -f dist/client/wrangler.json && cp -R dist/server/assets/. dist/client/assets/ && cp dist/server/index.js dist/client/server.js && cp pages-worker.js dist/client/_worker.js",
		"preview": "vite preview",
		"deploy": "bun run build && rm -rf .wrangler/deploy && wrangler pages deploy dist/client --project-name harnez-docs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/markdown": "^0.0.13",
		"@tanstack/solid-router": "latest",
		"@tanstack/solid-router-devtools": "latest",
		"@tanstack/solid-start": "latest",
		"mermaid": "^11.16.1",
		"solid-js": "^1.9.12",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.51.2",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/intent": "^0.3.6",
		"@tanstack/router-cli": "^1.133.21",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vite-plugin-solid": "^2.11.12",
		"wrangler": "^4.120.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
